    "current",
    "prototype_demo",
    "proposal",
    "future"
  ],
  "case_policy": {
    "case_is_final_guilt_judgment": false,
    "case_requires_escalation_threshold": true
  },
  "ai_context": {
    "knowledge_memory": "authoritative_versioned_corpus",
